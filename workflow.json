      "parameters": {
        "language": "pythonNative",
        "pythonCode": "if not _items:\n    return [{\"json\": {\"skip\": True}}]\n\nlignes = \"\"\nfor item in _items:\n    job = item[\"json\"]\n    lignes += f\"\"\"\n    <tr>\n        <td>{job.get('title')}</td>\n        <td>{job.get('company')}</td>\n        <td>{job.get('location')}</td>\n        <td>{job.get('score')}</td>\n        <td><a href=\"{job.get('url')}\">Voir l'offre</a></td>\n    </tr>\n    \"\"\"\n\nhtml = f\"\"\"\n<h2>Nouvelles offres — {len(_items)} trouvée(s)</h2>\n<table border=\"1\" cellpadding=\"6\" style=\"border-collapse:collapse\">\n<tr><th>Poste</th><th>Entreprise</th><th>Ville</th><th>Score</th><th>Lien</th></tr>\n{lignes}\n</table>\n\"\"\"\n\nreturn [{\"json\": {\"html_body\": html, \"count\": len(_items), \"skip\": False}}]"
      },
