    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# Modifiez cette liste selon le poste et la région recherchés.\n# Chaque ligne est une requête de recherche distincte, envoyée séparément à l'API.\nqueries = [\n    \"coordonnateur opérations Laval\",\n    \"amélioration continue Québec\",\n    \"analyste processus Couronne Nord\",\n    \"gestion des opérations Laval\",\n    \"responsable qualité Boisbriand\",\n]\n\nreturn [{\"json\": {\"query\": q}} for q in queries]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        -112
      ],
      "id": "8f3ee087-062a-4647-ab2b-7e8004790c67",
      "name": "Liste Queries"
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# Ajustez ces listes selon votre profil et votre marché cible.\nresults = []\n\nMOTS_CLES_FORTS = [\"amélioration continue\", \"lean\", \"kaizen\", \"structuration\", \"planification des opérations\", \"gestion des opérations\"]\nMOTS_CLES_TITRE_SENIOR = [\"directeur\", \"responsable production\", \"responsable qualité\", \"responsable opérations\", \"chef\", \"gestionnaire\"]\nMOTS_EXCLUSION = [\n    \"junior\", \"ventes\", \"communications\", \"rh, paie\", \"paie et opérations\",\n    \"succursale\", \"bâtiment et services\", \"immobilier\", \"funéraire\",\n    \"magasin\", \"boutique\", \"détail\", \"adjoint\", \"assistant manager\", \"mode\"\n]\nDOMAINES_EXCLUS = [\"bebee.com\"]\nVILLES_CIBLES = [\"laval\", \"boisbriand\", \"blainville\", \"terrebonne\", \"mirabel\", \"saint-eustache\"]\nSALAIRE_MIN = 75000\n\nfor item in _items:\n    jobs = item[\"json\"].get(\"data\", {}).get(\"jobs\", [])\n    for job in jobs:\n        url_offre = (job.get(\"job_apply_link\") or \"\").lower()\n\n        # Exclusion par domaine — sites avec candidature payante ou peu fiables\n        if any(domaine in url_offre for domaine in DOMAINES_EXCLUS):\n            continue\n\n        titre = (job.get(\"job_title\") or \"\").lower()\n        desc = (job.get(\"job_description\") or \"\").lower()\n        ville = (job.get(\"job_city\") or \"\").lower()\n        salaire_min = job.get(\"job_min_salary\") or 0\n\n        # Exclusion dure — si un mot d'exclusion apparaît dans le titre, on rejette direct\n        if any(mot in titre for mot in MOTS_EXCLUSION):\n            continue\n\n        score = 0\n        if any(mot in titre for mot in MOTS_CLES_TITRE_SENIOR):\n            score += 3\n        if any(mot in titre or mot in desc for mot in MOTS_CLES_FORTS):\n            score += 2\n        if ville in VILLES_CIBLES:\n            score += 1\n        if salaire_min and salaire_min >= SALAIRE_MIN:\n            score += 3\n\n        if score >= 4:\n            results.append({\n                \"job_id\": job.get(\"job_apply_link\"),  # URL utilisée comme identifiant stable, pas l'ID JSearch (instable d'une requête à l'autre)\n                \"title\": job.get(\"job_title\"),\n                \"company\": job.get(\"employer_name\"),\n                \"location\": job.get(\"job_city\"),\n                \"salaire\": salaire_min,\n                \"score\": score,\n                \"url\": job.get(\"job_apply_link\"),\n            })\n\nreturn [{\"json\": r} for r in results]"
      },
